{
  "openapi": "3.0.3",
  "info": {
    "title": "WinX Games API",
    "version": "1.0.0",
    "description": "Games module endpoints. No global prefix; all routes under /games. Responses are wrapped as { statusCode, message, data }."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local" }
  ],
  "tags": [
    { "name": "Public" },
    { "name": "User" },
    { "name": "Admin - Games" },
    { "name": "Admin - Rounds" },
    { "name": "Admin - Hot Numbers" },
    { "name": "Admin - Schedules" },
    { "name": "Unguarded (legacy)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "statusCode": { "type": "integer" },
          "message": { "type": "string" },
          "data": {}
        }
      },
      "UpdateGameSettingsDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 100 },
          "payoutMultiplier": { "type": "number", "minimum": 0.01 },
          "minBet": { "type": "number", "minimum": 0 },
          "maxBet": { "type": "number", "minimum": 0 },
          "maxPayoutPerRound": { "type": "number", "minimum": 1 }
        }
      },
      "UpdateGameFlagsDto": {
        "type": "object",
        "properties": {
          "isHot": { "type": "boolean" },
          "isJackpotBadge": { "type": "boolean" },
          "isActive": { "type": "boolean" },
          "displayCategory": { "type": "string", "enum": ["REGULAR", "JACKPOT", "INSTANT", "CUSTOM"] },
          "hotPriority": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "maxPayoutPerRound": { "type": "number", "minimum": 1 },
          "description": { "type": "string", "maxLength": 1000 },
          "thumbnailUrl": { "type": "string" }
        }
      },
      "CreateScheduleDto": {
        "type": "object",
        "required": ["intervalMinutes", "betDurationMinutes", "drawOffsetMinutes", "roundCodePrefix"],
        "properties": {
          "intervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "betDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "description": "Must be < intervalMinutes" },
          "drawOffsetMinutes": { "type": "integer", "minimum": 0, "maximum": 60 },
          "roundCodePrefix": { "type": "string", "maxLength": 20 },
          "nextRunAt": { "type": "string", "format": "date-time" },
          "isActive": { "type": "boolean" }
        }
      },
      "UpdateScheduleDto": {
        "type": "object",
        "properties": {
          "intervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "betDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "drawOffsetMinutes": { "type": "integer", "minimum": 0, "maximum": 60 },
          "roundCodePrefix": { "type": "string", "maxLength": 20 },
          "nextRunAt": { "type": "string", "format": "date-time" },
          "isActive": { "type": "boolean" }
        }
      },
      "CreateHotNumberDto": {
        "type": "object",
        "required": ["gameId", "number"],
        "properties": {
          "gameId": { "type": "integer" },
          "number": { "type": "string", "maxLength": 20 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "note": { "type": "string", "maxLength": 200 },
          "isActive": { "type": "boolean" }
        }
      },
      "UpdateHotNumberDto": {
        "type": "object",
        "properties": {
          "number": { "type": "string", "maxLength": 20 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "note": { "type": "string", "maxLength": 200 },
          "isActive": { "type": "boolean" }
        }
      },
      "ReorderHotNumbersDto": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "integer" }, "priority": { "type": "integer" } }
            }
          }
        }
      },
      "PlaceBet": {
        "type": "object",
        "required": ["game_id", "round_id", "bet_number", "amount"],
        "properties": {
          "user_id": { "type": "integer", "description": "Required for /games/bet; ignored for /games/bet-with-ticket (taken from token)" },
          "game_id": { "type": "integer" },
          "round_id": { "type": "integer" },
          "bet_number": { "type": "string" },
          "amount": { "type": "number" }
        }
      },
      "ResultBody": {
        "type": "object",
        "required": ["result_number"],
        "properties": { "result_number": { "type": "string" } }
      }
    }
  },
  "paths": {
    "/games/lobby": {
      "get": { "tags": ["Public"], "summary": "Home lobby grouped by digit category", "responses": { "200": { "description": "OK" } } }
    },
    "/games": {
      "get": {
        "tags": ["Public"], "summary": "List games (filterable)",
        "parameters": [
          { "name": "isActive", "in": "query", "schema": { "type": "boolean" } },
          { "name": "isHot", "in": "query", "schema": { "type": "boolean" } },
          { "name": "isJackpotBadge", "in": "query", "schema": { "type": "boolean" } },
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["REGULAR", "JACKPOT", "INSTANT", "CUSTOM"] } },
          { "name": "digitLength", "in": "query", "schema": { "type": "integer", "enum": [1, 3, 4, 5] } },
          { "name": "liveOnly", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/hot": { "get": { "tags": ["Public"], "summary": "Hot games", "responses": { "200": { "description": "OK" } } } },
    "/games/jackpot": { "get": { "tags": ["Public"], "summary": "Jackpot-badged games", "responses": { "200": { "description": "OK" } } } },
    "/games/by-type/{digitLength}": {
      "get": {
        "tags": ["Public"], "summary": "Games by digit type",
        "parameters": [{ "name": "digitLength", "in": "path", "required": true, "schema": { "type": "integer", "enum": [1, 3, 4, 5] } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/with-active-rounds": { "get": { "tags": ["Public"], "summary": "Games with an open round", "responses": { "200": { "description": "OK" } } } },
    "/games/active-rounds": {
      "get": {
        "tags": ["Public"], "summary": "All currently open rounds",
        "parameters": [
          { "name": "digitLength", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "gameId", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/results/feed": {
      "get": {
        "tags": ["Public"], "summary": "Global results feed",
        "parameters": [
          { "name": "hours", "in": "query", "schema": { "type": "integer", "default": 24 } },
          { "name": "gameId", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "digitLength", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/hot-numbers/by-category": { "get": { "tags": ["Public"], "summary": "Hot numbers by category (live games)", "responses": { "200": { "description": "OK" } } } },
    "/games/{id}": {
      "get": {
        "tags": ["Public"], "summary": "Game detail",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "Game not found" } }
      }
    },
    "/games/{gameId}/rounds": {
      "get": {
        "tags": ["Public"], "summary": "Rounds for a game",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["OPEN", "CLOSED", "RESULT_PUBLISHED", "SETTLED"] } },
          { "name": "date", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/{gameId}/active-rounds": {
      "get": {
        "tags": ["Public"], "summary": "Open rounds for a game",
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/{gameId}/results": {
      "get": {
        "tags": ["Public"], "summary": "Recent results for a game",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/{gameId}/hot-numbers": {
      "get": {
        "tags": ["Public"], "summary": "Public hot numbers for a game",
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/round/{roundId}/result": {
      "get": {
        "tags": ["Public"], "summary": "Result of a round",
        "parameters": [{ "name": "roundId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },

    "/games/my-bets": {
      "get": {
        "tags": ["User"], "summary": "Logged-in user's bet history", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "gameId", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/games/bet-with-ticket": {
      "post": {
        "tags": ["User"], "summary": "Place bet + generate PDF ticket", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceBet" } } } },
        "responses": { "201": { "description": "Created" }, "401": { "description": "Unauthorized" } }
      }
    },

    "/games/admin/list": {
      "get": { "tags": ["Admin - Games"], "summary": "List all games", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/games/admin/create-with-round": {
      "post": {
        "tags": ["Admin - Games"], "summary": "Create game + first round", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/admin/{id}/settings": {
      "patch": {
        "tags": ["Admin - Games"], "summary": "Update game economics", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateGameSettingsDto" } } } },
        "responses": { "200": { "description": "OK" }, "400": { "description": "Validation error" }, "404": { "description": "Game not found" } }
      }
    },
    "/games/admin/{id}/flags": {
      "patch": {
        "tags": ["Admin - Games"], "summary": "Update game flags/display", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateGameFlagsDto" } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/{id}": {
      "delete": {
        "tags": ["Admin - Games"], "summary": "Delete game", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "hard", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },

    "/games/admin/create-round": {
      "post": {
        "tags": ["Admin - Rounds"], "summary": "Create a round", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/admin/rounds/{roundId}/stats": {
      "get": {
        "tags": ["Admin - Rounds"], "summary": "Round number stats / exposure", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "roundId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/{gameId}/rounds-overview": {
      "get": {
        "tags": ["Admin - Rounds"], "summary": "Rounds overview for a game", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/rounds/awaiting-result": {
      "get": {
        "tags": ["Admin - Rounds"], "summary": "Closed rounds with no result", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/rounds/result-declared": {
      "get": {
        "tags": ["Admin - Rounds"], "summary": "Rounds published/settled", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/rounds/{roundId}/players": {
      "get": {
        "tags": ["Admin - Rounds"], "summary": "Players/bets in a round", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "roundId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },

    "/games/admin/{gameId}/hot-numbers": {
      "get": {
        "tags": ["Admin - Hot Numbers"], "summary": "List hot numbers (admin)", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "includeInactive", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/hot-numbers": {
      "post": {
        "tags": ["Admin - Hot Numbers"], "summary": "Create hot number", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateHotNumberDto" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/admin/hot-numbers/{id}": {
      "patch": {
        "tags": ["Admin - Hot Numbers"], "summary": "Update hot number", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateHotNumberDto" } } } },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Admin - Hot Numbers"], "summary": "Delete hot number", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/hot-numbers/{id}/toggle": {
      "post": {
        "tags": ["Admin - Hot Numbers"], "summary": "Toggle hot number active", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/hot-numbers/reorder": {
      "post": {
        "tags": ["Admin - Hot Numbers"], "summary": "Bulk reorder hot numbers", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReorderHotNumbersDto" } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },

    "/games/admin/schedules": {
      "get": { "tags": ["Admin - Schedules"], "summary": "List all schedules", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/games/admin/scheduler/health": {
      "get": { "tags": ["Admin - Schedules"], "summary": "Scheduler health (flags stale schedules)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/games/admin/{gameId}/schedule": {
      "get": {
        "tags": ["Admin - Schedules"], "summary": "Get a game's schedule", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No schedule" } }
      },
      "post": {
        "tags": ["Admin - Schedules"], "summary": "Create schedule", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateScheduleDto" } } } },
        "responses": { "201": { "description": "Created" }, "400": { "description": "betDuration >= interval or duplicate" } }
      },
      "patch": {
        "tags": ["Admin - Schedules"], "summary": "Update schedule (partial)", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateScheduleDto" } } } },
        "responses": { "200": { "description": "OK" }, "400": { "description": "Validation error" } }
      },
      "delete": {
        "tags": ["Admin - Schedules"], "summary": "Delete schedule", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/admin/{gameId}/schedule/toggle": {
      "post": {
        "tags": ["Admin - Schedules"], "summary": "Pause/resume schedule", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },

    "/games/bet": {
      "post": {
        "tags": ["Unguarded (legacy)"], "summary": "Place bet (NO AUTH - prefer bet-with-ticket)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceBet" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/settle/{round_id}": {
      "post": {
        "tags": ["Unguarded (legacy)"], "summary": "Settle round + pay winners (NO AUTH - should be admin)",
        "parameters": [{ "name": "round_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultBody" } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/games/create": {
      "post": {
        "tags": ["Unguarded (legacy)"], "summary": "Create game (NO AUTH - prefer admin/create-with-round)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/round": {
      "post": {
        "tags": ["Unguarded (legacy)"], "summary": "Create round (NO AUTH - prefer admin/create-round)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/hot-number": {
      "post": {
        "tags": ["Unguarded (legacy)"], "summary": "Add hot number (NO AUTH - prefer admin/hot-numbers)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/games/result/{round_id}": {
      "post": {
        "tags": ["Unguarded (legacy)"], "summary": "Publish result (NO AUTH - should be admin)",
        "parameters": [{ "name": "round_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultBody" } } } },
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
